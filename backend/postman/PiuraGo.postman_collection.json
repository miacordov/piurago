{
  "info": {
    "name": "PiuraGo API",
    "description": "Endpoints del backend de PiuraGo. Variables: `baseUrl` (por defecto http://localhost:8080) y `token` (se llena solo con \"Usuario anónimo\"). Ejecuta las carpetas en orden: las siguientes usan el token, el idRuta y el token de registrado que guardan las anteriores. El correo y la contraseña del usuario de prueba se generan al azar en cada ejecución. No guardes tokens reales en el archivo exportado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Datos de prueba al azar (no son credenciales reales).",
          "if (!pm.collectionVariables.get('deviceUuid')) {",
          "  pm.collectionVariables.set('deviceUuid', pm.variables.replaceIn('{{$guid}}'));",
          "}",
          "if (!pm.collectionVariables.get('emailPrueba')) {",
          "  const sufijo = Date.now();",
          "  pm.collectionVariables.set('emailPrueba', `postman${sufijo}@prueba.piurago`);",
          "  pm.collectionVariables.set('passwordPrueba', `Prueba-${sufijo}`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenRegistrado",
      "value": ""
    },
    {
      "key": "idRuta",
      "value": "1"
    },
    {
      "key": "deviceUuid",
      "value": ""
    },
    {
      "key": "emailPrueba",
      "value": ""
    },
    {
      "key": "passwordPrueba",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Salud (Actuator)",
      "description": "Health es público (para un monitor externo); info pide token.",
      "item": [
        {
          "name": "Health (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('está UP y sin detalles', () => {",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.status).to.eql('UP');",
                  "  pm.expect(r).to.not.have.property('components');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Info sin token: 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "info"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "01 Acceso",
      "description": "Usuario anónimo (guarda {{token}}), registro y login (guarda {{tokenRegistrado}}).",
      "item": [
        {
          "name": "Usuario anónimo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('devuelve token e idUsuario', () => {",
                  "  pm.expect(r.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(r.idUsuario).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('token', r.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/anonimo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "anonimo"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceUuid\": \"{{deviceUuid}}\",\n  \"tipoDispositivo\": \"WEB\"\n}",
              "options": {
